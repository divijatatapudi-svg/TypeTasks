{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["app.ts", "model.ts"],
  "exclude": ["node_modules"]
}
